{
  "name": "my-medusa-store",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "yarn -r dev",
    "build": "yarn -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ]
}
